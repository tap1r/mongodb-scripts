// Sample schema A, general purpose.
// A string that starts with "=" is an expression. Other strings, numbers, and null are literals.
// Expressions may use the preamble names oid, date, ts, idioma, totalDocs, n, and draws.
{
   "_id": "=oid",
   "schema": {
      "type": "A",
      "version": 1.0,
      "comment": "General purpose schema"
   },
   // hashed index. The shard key is date, ranged.
   "language": "=idioma",
   // n is the generation index. draws.<name> is the named value on this document.
   // A span shares that value across consecutive documents. A child follows one parent.
   // "seq": "=n",
   // "sku": "=draws.sku",
   // "skuAgain": "=draws.sku",
   "string": "=$genRandStr($getRandIntInc(6, 24))",
   "quote": {
      // idiomas[$getRandRatioInt([80, 0, 0, 5, 0, 3, 2])]
      // weights line up with the first seven labels in idiomas
      "language": "=idiomas[$getRandRatioInt([80, 0, 0, 5, 0, 3, 2])]",
      "txt": "=$genRandPhrase()"
      // "txt": (() => {
      //    const lines = $getRandIntInc(2, 512);
      //    let string = '';
      //    for (let line = 0; line < lines; line++) {
      //       string += `${$genRandStr($getRandIntInc(8, 24)) + $genRandSymbol()}`;
      //    }
      //    return string;
      // })()
   },
   "object": {
      "oid": "=oid",
      "str": "=$genRandAlpha($getRandIntInc(8, 16))",
      "num": "=+$getRandNum(-Math.pow(2, 12), Math.pow(2, 12)).toFixed(4)",
      "nestedArray": "=$genArrayElements($getRandIntInc(0, 4))"
   },
   "array": "=$genArrayElements($getRandIntInc(0, 4))",
   "objectArray": [
      { "nestedArray": "=$genArrayElements($getRandIntInc(0, 10))" }
   ],
   "1dArray": [
      { "2dArray": "=$genArrayElements($getRandIntInc(1, 10))" }
   ],
   "boolean": "=$bool()",
   // JavaScript (type 13). JavaScript with scope (type 15) is deprecated and still stored.
   "code": "=$genCode()",
   "codeScoped": "=$genCodeWithScope()",
   "date": "=date",
   "dateString": "=date.toISOString()",
   "timestamp": "=ts",
   "null": null,
   "int32": "=$NumberInt($getRandIntInc(int32MinVal, int32MaxVal))",
   "int64": "=$NumberLong($getRandIntInc(int64MinVal, int64MaxVal))",
   "double": "=$getRandNum(-Math.pow(2, 12), Math.pow(2, 12))",
   "decimal128": "=$NumberDecimal($getRandNum(dec128MinVal, dec128MaxVal))",
   "regex": "=$getRandRegex()",
   "bin": "=BinData(0, UUID().base64())",
   "uuid": "=UUID()",
   "md5": "=MD5($genRandHex(32))",
   "fle": "=BinData(6, UUID().base64())",
   // Subtype 7 is a BSON column of int32 literals. Subtype 8 is redacted in server logs.
   // Subtype 9 is a vector (float32, int8, or packed bits), listed on the v8 type table.
   "columnStore": "=$genColumn()",
   "sensitive": "=$genSensitive()",
   "vector": "=$genVector()",
   "random": "=+$getRandNum(0, totalDocs).toFixed(4)",
   "symbol": "=$genRandSymbol()",
   "credit card": "=$genRandCardNumber()"
}
