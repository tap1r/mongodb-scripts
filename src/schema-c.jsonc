// Sample schema C, GeoJSON.
// A string that starts with "=" is an expression. Other strings, numbers, and null are literals.
// Expressions may use the preamble names oid, date, ts, idioma, and totalDocs.
// $genPoint, $genLine, and $genPolygon draw the random geometries.
// A polygon shares one southwest corner, so the ring stays counterclockwise.
// $genPolygon(true) adds a clockwise hole inside that ring.
// multiPoint, multiLineString, and multiPolygon stay on fixed positions.
{
   "_id": "=oid",
   "schema": {
      "type": "C",
      "version": 1.0,
      "comment": "GeoJSON schema"
   },
   // hashed index. The shard key is date, ranged.
   "language": "=idioma",
   "string": "=$genRandStr($getRandIntInc(6, 24))",
   "temperature": [
      "=+$genNormal(15, 10).toFixed(1)",
      "=['K', '°F', '°C'][$getRandIntInc(0, 2)]"
   ],
   "dB": "=+$genNormal(20, 10).toFixed(3)",
   "status": "=['Active', 'Inactive', null][$getRandRatioInt([80, 20, 1])]",
   "locality": "=$getRandCountry()['alpha-3 code']",
   // GeoJSON Point
   "location": "=$genPoint()",
   // GeoJSON LineString
   "lineString": "=$genLine()",
   // GeoJSON Polygon. One corner, counterclockwise.
   "polygon": "=$genPolygon()",
   // Same triangle with a clockwise hole.
   "polygonMulti": "=$genPolygon(true)",
   // GeoJSON MultiPoint
   "multiPoint": {
      "type": "MultiPoint",
      "coordinates": [
         [-73.9580, 40.8003],
         [-73.9498, 40.7968],
         [-73.9737, 40.7648],
         [-73.9814, 40.7681]
      ]
   },
   // GeoJSON MultiLineString
   "multiLineString": {
      "type": "MultiLineString",
      "coordinates": [
         [
            [-73.96943, 40.78519],
            [-73.96082, 40.78095]
         ],
         [
            [-73.96415, 40.79229],
            [-73.95544, 40.78854]
         ],
         [
            [-73.97162, 40.78205],
            [-73.96374, 40.77715]
         ],
         [
            [-73.97880, 40.77247],
            [-73.97036, 40.76811]
         ]
      ]
   },
   // GeoJSON MultiPolygon
   "multiPolygon": {
      "type": "MultiPolygon",
      "coordinates": [
         [[
            [-73.958, 40.8003],
            [-73.9814, 40.7681],
            [-73.9737, 40.7648],
            [-73.9498, 40.7968],
            [-73.958, 40.8003]
         ]],
         [[
            [-73.930, 40.790],
            [-73.920, 40.790],
            [-73.920, 40.800],
            [-73.930, 40.800],
            [-73.930, 40.790]
         ]]
      ]
   },
   // GeoJSON GeometryCollection
   "geoCollection": {
      "type": "GeometryCollection",
      "geometries": [
         "=$genPoint()",
         "=$genLine()",
         "=$genPolygon()"
      ]
   }
}
