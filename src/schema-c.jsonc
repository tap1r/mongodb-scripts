// Sample schema C, GeoJSON.
// A string that starts with "=" is an expression. Other strings, numbers, and null are literals.
// Expressions may use the preamble names oid, date, ts, idioma, and totalDocs.
// The point, the line, both polygon fields, and the geometry collection draw coordinates.
// multiPoint, multiLineString, and multiPolygon use fixed positions.
{
   "_id": "=oid",
   "schema": {
      "type": "C",
      "version": 1.0,
      "comment": "GeoJSON schema"
   },
   "language": "=idioma",
   // hashed shard key
   "string": "=$genRandStr($getRandIntInc(6, 24))",
   "temperature": [
      "=+$genNormal(15, 10).toFixed(1)",
      "=['K', '°F', '°C'][$getRandIntInc(0, 2)]"
   ],
   "dB": "=+$genNormal(20, 10).toFixed(3)",
   "status": "=['Active', 'Inactive', null][$getRandRatioInt([80, 20, 1])]",
   "locality": "=$getRandCountry()['alpha-3 code']",
   // GeoJSON Point
   "location": {
      "type": "Point",
      "coordinates": [
         "=+$getRandNum(-180, 180).toFixed(4)",
         "=+$getRandNum(-90, 90).toFixed(4)"
      ]
   },
   // GeoJSON LineString
   "lineString": {
      "type": "LineString",
      "coordinates": [
         [
            "=+$getRandNum(-180, 180).toFixed(4)",
            "=+$getRandNum(-90, 90).toFixed(4)"
         ],
         [
            "=+$getRandNum(-180, 180).toFixed(4)",
            "=+$getRandNum(-90, 90).toFixed(4)"
         ]
      ]
   },
   // polygon with a single ring. East and north offsets stay positive, so the ring is counterclockwise.
   "polygon": {
      "type": "Polygon",
      "coordinates": [[
         [0, 0],
         ["=+$getRandNum(0.1, 1).toFixed(4)", 0],
         [0, "=+$getRandNum(0.1, 1).toFixed(4)"],
         [0, 0]
      ]]
   },
   // shell offsets are at least 1, so the clockwise hole stays inside the triangle
   "polygonMulti": {
      "type": "Polygon",
      "coordinates": [
         [
            [0, 0],
            ["=+$getRandNum(1, 2).toFixed(4)", 0],
            [0, "=+$getRandNum(1, 2).toFixed(4)"],
            [0, 0]
         ],
         [
            [0.2, 0.2],
            [0.2, 0.35],
            [0.35, 0.2],
            [0.2, 0.2]
         ]
      ]
   },
   // GeoJSON MultiPoint
   "multiPoint": {
      "type": "MultiPoint",
      "coordinates": [
         [-73.9580, 40.8003],
         [-73.9498, 40.7968],
         [-73.9737, 40.7648],
         [-73.9814, 40.7681]
      ]
   },
   // GeoJSON MultiLineString
   "multiLineString": {
      "type": "MultiLineString",
      "coordinates": [
         [
            [-73.96943, 40.78519],
            [-73.96082, 40.78095]
         ],
         [
            [-73.96415, 40.79229],
            [-73.95544, 40.78854]
         ],
         [
            [-73.97162, 40.78205],
            [-73.96374, 40.77715]
         ],
         [
            [-73.97880, 40.77247],
            [-73.97036, 40.76811]
         ]
      ]
   },
   // GeoJSON MultiPolygon
   "multiPolygon": {
      "type": "MultiPolygon",
      "coordinates": [
         [[
            [-73.958, 40.8003],
            [-73.9814, 40.7681],
            [-73.9737, 40.7648],
            [-73.9498, 40.7968],
            [-73.958, 40.8003]
         ]],
         [[
            [-73.930, 40.790],
            [-73.920, 40.790],
            [-73.920, 40.800],
            [-73.930, 40.800],
            [-73.930, 40.790]
         ]]
      ]
   },
   // GeoJSON GeometryCollection
   "geoCollection": {
      "type": "GeometryCollection",
      "geometries": [
         {
            "type": "Point",
            "coordinates": [
               "=+$getRandNum(-180, 180).toFixed(4)",
               "=+$getRandNum(-90, 90).toFixed(4)"
            ]
         },
         {
            "type": "LineString",
            "coordinates": [
               [
                  "=+$getRandNum(-180, 180).toFixed(4)",
                  "=+$getRandNum(-90, 90).toFixed(4)"
               ],
               [
                  "=+$getRandNum(-180, 180).toFixed(4)",
                  "=+$getRandNum(-90, 90).toFixed(4)"
               ]
            ]
         },
         {
            "type": "Polygon",
            "coordinates": [[
               [0, 0],
               ["=+$getRandNum(0.1, 1).toFixed(4)", 0],
               [0, "=+$getRandNum(0.1, 1).toFixed(4)"],
               [0, 0]
            ]]
         }
      ]
   }
}
