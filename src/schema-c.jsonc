// Sample schema C, GeoJSON.
// A string that starts with "=" is an expression. Other strings, numbers, and null are literals.
// Expressions may use the preamble names oid, date, ts, idioma, totalDocs, n, and draws.
// $genPoint, $genLine, and $genPolygon draw the single geometries.
// A polygon shares one southwest corner, so the ring stays counterclockwise.
// $genPolygon(true) adds a clockwise hole inside that ring, at least one degree off either pole.
// $genMultiPoint, $genMultiLineString, and $genMultiPolygon draw the multi geometries.
// Each line and each polygon uses one southwest corner, the way the single helpers do.
// An omitted count is 2 to 4.
// $genMultiPolygon(true) adds a clockwise hole inside each triangle.
{
   "_id": "=oid",
   "schema": {
      "type": "C",
      "version": 1.0,
      "comment": "GeoJSON schema"
   },
   // hashed index. The shard key is date, ranged.
   "language": "=idioma",
   "string": "=$genRandStr($getRandIntInc(6, 24))",
   "temperature": [
      "=+$genNormal(15, 10).toFixed(1)",
      "=['K', '°F', '°C'][$getRandIntInc(0, 2)]"
   ],
   "dB": "=+$genNormal(20, 10).toFixed(3)",
   "status": "=['Active', 'Inactive', null][$getRandRatioInt([80, 20, 1])]",
   "locality": "=$getRandCountry()['alpha-3 code']",
   // GeoJSON Point
   "location": "=$genPoint()",
   // GeoJSON LineString
   "lineString": "=$genLine()",
   // GeoJSON Polygon. One corner, counterclockwise.
   "polygon": "=$genPolygon()",
   // Same triangle with a clockwise hole.
   "polygonMulti": "=$genPolygon(true)",
   // GeoJSON MultiPoint. 2 to 4 positions.
   "multiPoint": "=$genMultiPoint()",
   // GeoJSON MultiLineString. Each line shares one corner.
   "multiLineString": "=$genMultiLineString()",
   // GeoJSON MultiPolygon. Each shell is counterclockwise.
   "multiPolygon": "=$genMultiPolygon()",
   // Same polygons with a clockwise hole in each.
   "multiPolygonHole": "=$genMultiPolygon(true)",
   // GeoJSON GeometryCollection. Composed from the helpers. No collection helper.
   "geoCollection": {
      "type": "GeometryCollection",
      "geometries": [
         "=$genPoint()",
         "=$genLine()",
         "=$genPolygon()",
         "=$genPolygon(true)",
         "=$genMultiPoint()",
         "=$genMultiLineString()",
         "=$genMultiPolygon()",
         "=$genMultiPolygon(true)"
      ]
   }
}
