// Sample schema B, time series.
// A string that starts with "=" is an expression. Other strings, numbers, and null are literals.
// Expressions may use the preamble names oid, date, ts, idioma, and totalDocs.
// tsOptions.timeField is "timestamp" and tsOptions.metaField is "data".
// This sample stores the Date at "timestamp" and the series name at "data".
// A time series run keeps this file. Schema A stores a Timestamp at
// "timestamp", and schema C has no Date there, so those files are omitted.
{
   "_id": "=oid",
   "schema": {
      "type": "B",
      "version": 1.0,
      "comment": "Time series schema"
   },
   // hashed index. A time series shard key is data, ranged.
   "language": "=idioma",
   "string": "=$genRandStr($getRandIntInc(6, 24))",
   "timestamp": "=date",
   // ['Series 1', 'Series 2', 'Series 3'][$getRandRatioInt([70, 20, 10])]
   "data": "=['Series 1', 'Series 2', 'Series 3'][$getRandRatioInt([70, 20, 10])]",
   "granularity": "hours",
   // Benford magnitude in [1, 1e6). qty stays a uniform count.
   "unit": "=+$benford(0, 5).toFixed(2)",
   "qty": "=$getRandIntInc(0, Math.pow(10, 4))",
   "price": [
      // Benford amount in [0.01, 1e4)
      "=+$benford(-2, 3).toFixed(2)",
      "=$genRandCurrency()"
   ]
}
